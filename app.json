{
  "expo": {
    "name": "LostAndFound",
    "slug": "lostandfound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f1ef0f5e-d8f3-4647-a396-b4df13b15219"
      }
    },
    "owner": "vladinikolovs-team",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложението иска достъп до снимките ти, за да добавиш снимка на вещта.",
          "cameraPermission": "Приложението иска достъп до камерата, за да снимаш вещта."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Приложението използва местоположението ти, за да попълни къде е изгубена или намерена вещта."
        }
      ]
    ]
  }
}
